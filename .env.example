# OpenAI-compatible model service
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.6-flash
LLM_API_KEY=replace-with-local-secret
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2

# WeCom intelligent robot, API mode with long connection
WECOM_BOT_ID=replace-with-local-bot-id
WECOM_BOT_SECRET=replace-with-local-bot-secret

# Local runtime
KNOWLEDGE_MODE=experimental
LOG_DIR=logs
